cabal-version:      2.4
name:               parser_v7
version:            0.1.0.0
build-type:         Simple

executable parser_v7
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: Haskell2010
  ghc-options:      -O2 -Wall

  build-depends:
      base >=4.16 && <5
    , aeson
    , bytestring
    , containers
    , text
    , unordered-containers
    , vector
